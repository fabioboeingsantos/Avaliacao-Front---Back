# Supabase/PostgreSQL: use a URI copiada em Connect > Session pooler.
# Para redes IPv4, o Session pooler usa a porta 5432. Mantenha a senha separada.
# Exemplo local: postgresql+psycopg://postgres.<project-ref>@<pooler-host>:5432/postgres?sslmode=require&connect_timeout=8
# Na Vercel, use Transaction pooler (porta 6543) e senha separada, sem aspas no painel.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# Alternativa local sem Supabase:
BANCO_DRIVER=sqlite
BANCO_NOME=./cesta_do_vale.db

# Variáveis usadas somente pelo Docker Compose local com MySQL.
BANCO_USUARIO=cesta_app
BANCO_SENHA=
BANCO_HOST=db
BANCO_PORTA=3306
MYSQL_ROOT_PASSWORD=
FRONTEND_URL=http://localhost:8080,http://127.0.0.1:8080
# Gere uma chave aleatória local com pelo menos 32 caracteres.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=false
# Protecoes contra abuso no login e no cadastro.
AUTH_LOGIN_LIMIT=5
AUTH_SIGNUP_LIMIT=3
AUTH_RATE_WINDOW_SECONDS=900
AUTH_BLOCK_SECONDS=900
HTTP_PORT=8080

# E-mails transacionais (somente backend). Não use prefixo VITE_ nestas chaves.
EMAIL_FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Assistente: OpenRouter ativo para todos os agentes; simulado desliga chamadas externas.
ASSISTENTE_MODO=openrouter

# Escolha o provedor padrão e, se quiser, substitua-o em cada agente.
IA_PROVEDOR_PADRAO=openrouter
IA_PROVEDOR_INTERPRETE=openrouter
IA_PROVEDOR_ASSINANTE=openrouter
IA_PROVEDOR_PRODUTOR=openrouter
IA_PROVEDOR_QA=openrouter
IA_FALLBACK_JANGADA=true
IA_GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Modelos por agente. Campos vazios usam IA_MODELO_PADRAO.
IA_MODELO_PADRAO=openrouter/free
IA_MODELO_INTERPRETE=
IA_MODELO_ASSINANTE=
IA_MODELO_PRODUTOR=
IA_MODELO_QA=

# OpenRouter: somente openrouter/free ou modelos com sufixo :free.
OPENROUTER_API_KEY=
# Gemini é a reserva automática; OpenAI permanece inativa.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Modelo lido pelo chat de demonstração independente.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=40
OPENROUTER_MAX_TOKENS=2048

# Modelo usado pelo chat de demonstração Jangada.
GEMINI_MODEL=gemini-3.5-flash-lite

# Voz da Flora: navegador mantém a síntese atual; google ativa a Aoede feminina pt-BR.
# Requer Cloud Text-to-Speech ativado e faturamento no projeto Google Cloud.
# A chave fica somente no backend, sem prefixo VITE_. Restrinja-a à Cloud Text-to-Speech API.
FLORA_VOZ_PROVEDOR=navegador
GOOGLE_TTS_API_KEY=
