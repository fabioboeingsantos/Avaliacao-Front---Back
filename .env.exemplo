# Supabase/PostgreSQL: use a URI copiada em Connect > Session pooler.
# Para redes IPv4, o Session pooler usa a porta 5432. Mantenha a senha separada.
# Exemplo local: postgresql+psycopg://postgres.<project-ref>@<pooler-host>:5432/postgres?sslmode=require&connect_timeout=8
# Na Vercel, use Transaction pooler (porta 6543) e senha separada, sem aspas no painel.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# Alternativa local sem Supabase:
BANCO_DRIVER=sqlite
BANCO_NOME=./cesta_do_vale.db

# Variáveis usadas somente pelo Docker Compose local com MySQL.
BANCO_USUARIO=cesta_app
BANCO_SENHA=
BANCO_HOST=db
BANCO_PORTA=3306
MYSQL_ROOT_PASSWORD=
FRONTEND_URL=http://localhost:8080,http://127.0.0.1:8080
# Gere uma chave aleatória local com pelo menos 32 caracteres.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=false
# Protecoes contra abuso no login e no cadastro.
AUTH_LOGIN_LIMIT=5
AUTH_SIGNUP_LIMIT=3
AUTH_RATE_WINDOW_SECONDS=900
AUTH_BLOCK_SECONDS=900
HTTP_PORT=8080

# E-mails transacionais (somente backend). Não use prefixo VITE_ nestas chaves.
EMAIL_FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Assistente: simulado funciona sem chave. Para API real, use openrouter.
ASSISTENTE_MODO=simulado

# OpenRouter: somente openrouter/free ou modelos com sufixo :free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODEL_INTERPRETE=
OPENROUTER_MODEL_ASSINANTE=
OPENROUTER_MODEL_PRODUTOR=
OPENROUTER_MODEL_QA=
OPENROUTER_TIMEOUT_SECONDS=40
OPENROUTER_MAX_TOKENS=2048
